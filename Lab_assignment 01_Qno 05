#include<stdio.h>

int main(){
    int numb1;
    int numb2;

    printf("Enter first number\n");
    scanf("%d", &numb1);

    printf("Enter second number\n");
    scanf("%d", &numb2);

    numb1 = numb1 + numb2;
    numb2 = numb1 - numb2;
    numb1 = numb1 - numb2;

    printf("After swapping:\n");
    printf("First number: %d\n", numb1);
    printf("Second number: %d\n", numb2);

    return 0;

}
