#include<stdio.h>

int main(){
    int distance;
    printf("Enter distance\n");
    scanf("%d",&distance);
    printf("distance in Km:%d\n",distance);

    int distance_m;
    distance_m=distance*1000;
    printf("distance in m:%d\n",distance_m);

    int distance_cm;
    distance_cm=distance_m*100;
    printf("distance in cm:%d\n",distance_cm);
    return 0;
}
